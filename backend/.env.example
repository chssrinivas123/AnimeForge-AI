# Copy this file to .env and fill in your local MySQL 8 credentials.
# DATABASE_URL=mysql+pymysql://animeforge:your_password@localhost:3306/animeforge_db?charset=utf8mb4
# Or set each variable individually:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=animeforge
MYSQL_PASSWORD=change_me
MYSQL_DB=animeforge_db

# Optional: set this to use a local SQLite database for development/test fallback.
# DATABASE_URL=sqlite:///./animeforge_dev.db
